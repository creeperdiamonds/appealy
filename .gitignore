# ---------------------------------------------------------------------------
# Secrets
#
# .env holds the bot token, OAuth client secret, session secret, and the
# AES key used to encrypt stored Discord tokens. setup.sh writes real values
# into it, and this repo is public. Nothing here is recoverable once pushed —
# a leaked bot token has to be reset in the Developer Portal, and every stored
# token encrypted under a leaked TOKEN_ENCRYPTION_KEY has to be invalidated.
#
# .env.example is tracked on purpose; it contains no values.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
# Templates end in .example and contain no values. Without this line the
# .env.* rule above swallows them and they never get committed.
!.env.production.example

*.pem
*.key
secrets/

# ---------------------------------------------------------------------------
# Distribution archives
#
# A zip of the repo, committed into the repo. Every version of it is kept in
# git history forever, so a 400KB archive pushed a few times becomes megabytes
# of permanent clone weight for something nobody ever reads from git. Use
# GitHub Releases for distributables.
# ---------------------------------------------------------------------------
*.zip
appealy-complete.zip

# ---------------------------------------------------------------------------
# Terraform
#
# tfstate holds the generated database password in plaintext, and tfvars names
# your project. Neither belongs in a public repo.
# ---------------------------------------------------------------------------
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
terraform.tfvars
!terraform.tfvars.example

# ---------------------------------------------------------------------------
# Dependencies and build output
# ---------------------------------------------------------------------------
node_modules/
dist/
build/
.vite/
*.tsbuildinfo

# Deno's local cache, if DENO_DIR is pointed inside the repo
.deno/
deno.lock.bak

# ---------------------------------------------------------------------------
# Runtime artifacts
# ---------------------------------------------------------------------------
# Written by bot/src/core/statusPublisher.ts. Regenerated every 10s; committing
# a snapshot would publish a stale one to anyone reading the repo.
status/status.json
status/directory.json
status/.*.tmp

*.log
logs/
pids/
*.pid

# Docker volume mounts, if bound locally
pgdata/
redisdata/

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# ---------------------------------------------------------------------------
# Test and coverage
# ---------------------------------------------------------------------------
coverage/
.nyc_output/
