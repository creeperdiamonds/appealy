# =============================================================================
#  .env.production.example  —  template for a real hosted deployment
#
#  Copy to .env on the server and fill in. Every value below is a placeholder;
#  nothing here is a working credential.
#
#      cp .env.production.example .env
#      nano .env
#
#  This file is safe to commit. The .env you create from it is NOT — .gitignore
#  already covers it, but check `git status` before your first push anyway.
#
#  Differences from .env.example (the self-hosting one):
#    - DEPLOYMENT_MODE=platform, so billing is on
#    - a real domain and HTTPS redirect URI
#    - a database password you generate, not "appealy"
#    - tighter caps, because the guilds using this aren't all yours
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Deployment mode
# -----------------------------------------------------------------------------
# "platform" here, not "self". Requires a billing source below (Discord SKUs
# or Stripe) — startup fails with an explanation if neither is configured.
DEPLOYMENT_MODE=platform

BRAND_NAME=Appealy

# Where banned users are told to appeal. Must be reachable — if it 404s, the
# ban notice sends people somewhere that doesn't exist.
SUPPORT_URL=https://your-domain.example/appeal

# Public shard status page. Worth having once other people depend on the bot.
ENABLE_PUBLIC_STATUS=true
ENABLE_BANS=true


# -----------------------------------------------------------------------------
# 2. Discord application
#    https://discord.com/developers/applications
# -----------------------------------------------------------------------------
# General Information → Application ID
DISCORD_APPLICATION_ID=000000000000000000

# General Information → Public Key
DISCORD_PUBLIC_KEY=replace_with_your_public_key

# Bot → Token. If you've ever pasted this anywhere, reset it and use the new one.
DISCORD_BOT_TOKEN=replace_with_your_bot_token

# OAuth2 → Client ID / Client Secret
DISCORD_CLIENT_ID=000000000000000000
DISCORD_CLIENT_SECRET=replace_with_your_client_secret

# Must match OAuth2 → Redirects EXACTLY, including scheme and trailing path.
# HTTPS is required on any non-localhost host — Discord rejects plain HTTP.
#
# This must be the CONSOLE's origin, not the API's, and the same origin as
# FRONTEND_ORIGIN below. The console proxies /auth to the API (web/nginx.conf),
# so the callback that issues Set-Cookie is served from the origin the
# dashboard actually runs on, and the session cookie is first-party.
#
# If you deploy to Cloud Run's default hostnames, this is the appealy-web URL,
# never the appealy-api one. Two *.run.app hostnames are different SITES —
# run.app is a public suffix — so a cookie set on the api host is never sent
# by the console. That failure looks like a broken session, not a broken URL.
DISCORD_REDIRECT_URI=https://your-domain.example/auth/discord/callback


# -----------------------------------------------------------------------------
# 3. Secrets — generate these, don't invent them
# -----------------------------------------------------------------------------
#   SESSION_SECRET:        openssl rand -hex 48
#   TOKEN_ENCRYPTION_KEY:  openssl rand -hex 32     (must be exactly 64 chars)
#   POSTGRES_PASSWORD:     openssl rand -base64 24
#
# TOKEN_ENCRYPTION_KEY encrypts stored Discord tokens. Changing it later
# invalidates every stored token and forces all users to re-authorize, so
# generate it once and back it up somewhere you'll still have in a year.
SESSION_SECRET=generate_with_openssl_rand_hex_48
TOKEN_ENCRYPTION_KEY=generate_with_openssl_rand_hex_32


# -----------------------------------------------------------------------------
# 4. Database and cache
# -----------------------------------------------------------------------------
# Change the password from the compose default. If Postgres is on the same
# host, keep it bound to 127.0.0.1 (docker-compose.yml already does).
POSTGRES_USER=appealy
POSTGRES_PASSWORD=generate_a_long_random_password
POSTGRES_DB=appealy

DATABASE_URL=postgresql://appealy:generate_a_long_random_password@postgres:5432/appealy
REDIS_URL=redis://redis:6379


# -----------------------------------------------------------------------------
# 5. Billing — pick one
# -----------------------------------------------------------------------------
# Discord subscriptions (recommended): Discord is merchant of record, so no
# payment processor to onboard and no tax handling. Create SKUs under
# Monetization in the Developer Portal, then map them here.
#
# Format: SKU_ID:tier,SKU_ID:tier   (tiers: tier1, tier2, tier3)
# A malformed entry throws at startup — an unmapped SKU means someone pays and
# silently receives nothing.
DISCORD_SKU_TIERS=

# Stripe. Leave blank if using Discord subscriptions. Live keys REQUIRE
# STRIPE_WEBHOOK_SECRET — without it checkout succeeds and no subscription
# ever activates, so the app refuses to start rather than let that happen.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# 6. Operator access
# -----------------------------------------------------------------------------
# Your Discord user ID, and anyone else who reviews appeals or issues bans.
# Not a credential — user IDs are public. Empty means the operator surface is
# off entirely, so at minimum put your own here or nobody can review anything.
#
# Discord → Settings → Advanced → Developer Mode, then right-click yourself.
OPS_USER_IDS=000000000000000000


# -----------------------------------------------------------------------------
# 7. Your own servers
# -----------------------------------------------------------------------------
# Guilds that skip tier limits — typically your main server and support server.
# Not clamped to the normal ceiling; you're the one who gets paged.
PRIVILEGED_GUILD_IDS=

# Optional per-cap overrides. Unset means "as high as the system goes".
#PRIVILEGED_CAP_SUBMISSIONS_PER_DAY=100000
#PRIVILEGED_CAP_FORMS_PER_GUILD=1000


# -----------------------------------------------------------------------------
# 8. Sharding
# -----------------------------------------------------------------------------
# One shard per this many guilds, recalculated at each startup. 1000 is
# Discord's own ratio; lowering it costs memory and session starts for nothing.
GUILDS_PER_SHARD=1000

# Ceiling so a bad ratio can't try to open hundreds of connections. 16 is
# plenty until you're well past ten thousand guilds.
MAX_SHARDS=16


# -----------------------------------------------------------------------------
# 9. Runtime
# -----------------------------------------------------------------------------
NODE_ENV=production
APPEALY_ENV=production
LOG_LEVEL=info

DASHBOARD_BASE_URL=https://your-domain.example
FRONTEND_ORIGIN=https://your-domain.example

# Command registration is a deploy step, not a boot step — Discord allows only
# 200 global command creates per day and boot-time sync spends that on
# restarts. Leave this false and run `deno task sync-commands` after deploys.
SYNC_COMMANDS_ON_BOOT=false


# =============================================================================
#  Before you go live
# =============================================================================
#
#   [ ] Every "replace_" / "generate_" / "your-domain" above is filled in
#   [ ] DISCORD_REDIRECT_URI matches OAuth2 → Redirects character for character
#   [ ] Privileged intents enabled: Server Members, Message Content
#   [ ] TLS in front of the dashboard (Caddy is the least work)
#   [ ] `git status` shows no .env
#   [ ] Backups: pg_dump on a schedule, restored once to prove it works
#   [ ] TOKEN_ENCRYPTION_KEY stored somewhere other than the server
#
#  The last two are the ones people skip. A backup you've never restored is a
#  hypothesis, and a lost encryption key means every user re-authorizes.
# =============================================================================
