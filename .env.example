# ---- Deployment mode ----
# This template is pinned to "self" on purpose, and you should leave it alone.
#
#   self      you run this for your own server(s). Billing off, no Stripe
#             account needed, caps come from the CAP_* values below.
#   platform  the hosted appealy.gg deployment. Requires working Stripe config.
#
# Pinned rather than blank because blank means the mode is INFERRED from
# whether STRIPE_SECRET_KEY is set — which is the right behaviour for a
# deployment someone has deliberately configured, and the wrong behaviour for
# a file everybody copies. A stray Stripe key in a cloned .env would silently
# promote a self-hosted instance into platform mode and switch on billing
# routes nobody asked for. An explicit value can't be surprised into changing.
#
# Anyone who wants the inference back can blank this line; the logic still
# exists and logs whichever mode it picks. Setting "platform" here without
# valid Stripe keys fails at startup with a message that says so.
DEPLOYMENT_MODE=self

BRAND_NAME=
# Where a banned user or server is told to appeal. Leave empty if you have no
# appeal process — the notice then states the reason and stops, rather than
# sending your users somewhere that doesn't exist.
SUPPORT_URL=
ENABLE_PUBLIC_STATUS=false
ENABLE_BANS=true

# ---- Operator access ----
# Discord user IDs allowed to reach /api/ops. NOT credentials — a user ID is
# public. Nobody types one in; the id comes from the OAuth session after login
# and this list only decides who that session is allowed to be. Empty means the
# operator surface is off for everyone. Startup fails on a malformed entry.
OPS_USER_IDS=

# ---- Discord subscriptions (optional; platform mode) ----
# Maps Discord SKU ids to tiers:  SKU:tier,SKU:tier
#
#   DISCORD_SKU_TIERS=1234567890123456789:tier1,2345678901234567890:tier2
#
# Preferable to Stripe for a Discord bot: Discord is merchant of record, so
# there's no payment processor to onboard, no PCI surface, and no tax handling
# of your own. Purchase happens inside Discord. Discord's own Monetization
# Requirements policy also expects paid apps to offer Premium Apps pricing no
# higher than elsewhere, so this isn't really optional next to Stripe.
#
# Costs: Discord's platform fee (15% under $1M cumulative, 30% after), and
# availability is limited to US/UK/EU-based developers.
#
# Self-hosters: leave blank. Entitlements belong to the application that sold
# them, so a self-hosted bot with its own token has none by construction —
# there is nothing to disable.
#
# Malformed entries throw at startup, deliberately: an unmapped SKU means a
# customer pays and silently receives nothing.
DISCORD_SKU_TIERS=

# ---- Sharding ----
# One shard per this many guilds, recalculated at every startup. 1000 is
# Discord's own ratio; there's rarely a good reason to change it.
#
# Lowering it does NOT spread load more finely for free — each extra shard is
# another WebSocket, ~40-60MB of memory, another 5s of startup, and another
# Discord "session start" spent on every restart. Below 1000 guilds a single
# shard is strictly better than two, not a compromise.
GUILDS_PER_SHARD=1000

# Hard ceiling so a bad ratio can't try to open hundreds of connections on a
# small machine. On a Raspberry Pi, 4 is a sensible limit.
MAX_SHARDS=16

# ---- Raised caps for your own servers ----
# Comma-separated guild IDs that bypass tier limits entirely. Typically your
# own server and your support server. Works in both modes.
#
# These are NOT clamped to the ceiling in shared/schema/pricing.ts. That
# ceiling exists to stop a *customer* self-serving unbounded throughput
# through the pricing slider; you editing your own .env is a different thing,
# and you are the one who gets paged if it's wrong.
#
# Unset means nobody is privileged. A malformed ID fails at startup rather
# than silently never matching.
PRIVILEGED_GUILD_IDS=

# Optional. Unset caps default to CUSTOM_CAP_MAXIMUMS — "as high as this
# system was designed to go". Set these only when that genuinely isn't enough.
# Must be finite: your server shares one Postgres pool with every other guild,
# so an uncapped runaway loop in yours takes everyone down with it.
#PRIVILEGED_CAP_SUBMISSIONS_PER_DAY=100000
#PRIVILEGED_CAP_TICKETS_PER_DAY=50000
#PRIVILEGED_CAP_GIVEAWAY_ENTRIES_PER_DAY=500000
#PRIVILEGED_CAP_API_REQUESTS_PER_MINUTE=10000
#PRIVILEGED_CAP_FORMS_PER_GUILD=1000
#PRIVILEGED_CAP_PANELS_PER_GUILD=1000
#PRIVILEGED_CAP_ROLES_PER_RULE_TYPE=250
#PRIVILEGED_CAP_HISTORY_RETENTION_DAYS=3650

# ---- Caps (self mode only; ignored in platform mode) ----
CAP_FORMS_PER_GUILD=100
CAP_QUESTIONS_PER_FORM=50
CAP_SUBMISSIONS_PER_DAY=10000
CAP_TICKETS_PER_DAY=5000
CAP_PANELS_PER_GUILD=100
CAP_POLLS_PER_GUILD=100
CAP_GIVEAWAYS_PER_GUILD=100
CAP_ROLE_MENUS_PER_GUILD=100

# ---- Discord application ----
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3001/auth/discord/callback

# ---- Database / cache ----
DATABASE_URL=postgres://appealy:appealy@localhost:5432/appealy
REDIS_URL=redis://localhost:6379

# ---- API service ----
PORT=3001
SESSION_SECRET=change_me_to_a_long_random_string
# 32-byte key, hex-encoded (64 hex chars). Generate with:
#   openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# ---- Stripe billing ----
# All plans in this project are billed ANNUALLY ONLY — see the comment at
# the top of shared/schema/pricing.ts for why (standard card fees are
# roughly 2.9% + $0.30/transaction, which would eat a large share of our
# small monthly-equivalent prices; one annual charge instead of twelve
# monthly ones cuts the effective fee rate roughly 3x).
# Get these from your Stripe dashboard (Developers > API keys, and
# Developers > Webhooks > your endpoint > Signing secret).
# Platform mode only. Leave BLANK when self-hosting — blank is what makes the
# mode resolve to "self".
#
# Validated at startup for shape, not just presence:
#   - a leftover placeholder is treated as blank, not as a key
#   - a publishable key (pk_...) pasted here is rejected with a pointer to the
#     right one, rather than 401ing against Stripe hours later
#   - live keys with no STRIPE_WEBHOOK_SECRET refuse to start (see below)
STRIPE_SECRET_KEY=
# Required alongside a live secret key, and the reason is worth reading:
# without it, checkout completes and no subscription ever activates, because
# nothing can verify Stripe's callbacks. That failure is invisible until a
# customer's plan doesn't change after they pay — so platform mode with live
# keys and no webhook secret refuses to boot.
# Stripe -> Developers -> Webhooks -> your endpoint -> Signing secret.
STRIPE_WEBHOOK_SECRET=
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development

# ---- Bot <-> API internal RPC ----
# Shared secret protecting the bot's internal control server. Generate with:
#   openssl rand -hex 32
INTERNAL_RPC_SECRET=
BOT_INTERNAL_URL=http://localhost:9090
BOT_INTERNAL_PORT=9090

# ---- Dashboard link shown by /dashboard slash command ----
DASHBOARD_BASE_URL=http://localhost:5173

LOG_LEVEL=info
