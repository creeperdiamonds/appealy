{
  "name": "appealy-api",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "cookie-parser": "^1.4.6",
    "zod": "^3.23.8",
    "drizzle-orm": "^0.33.0",
    "ioredis": "^5.4.1",
    "postgres": "^3.4.4",
    "stripe": "^16.8.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/cookie-parser": "^1.4.7",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "tsx": "^4.16.2",
    "drizzle-kit": "^0.24.0"
  }
}
